@host = http://localhost:5086

### Register
POST {{host}}/Auth/register
Content-Type: application/json
Accept: application/json

{
  "firstName": "abdullah",
  "lastName": "Ali",
  "email": "ldd@gmail.com",
  "password": "Abullahhindawy"
}

### Login
POST {{host}}/Auth/login
Content-Type: application/json

{
    "email": "ldd@gmail.com",
  "password": "Abullahhindawy"
}
